# --- Database (MySQL) ---
DATABASE_URL=mysql://root:root@localhost:3306/neox_testnet

# --- Neo X EVM RPC node ---
# Testnet T4 (chainId 12227332):
NODE_URL=https://neoxt4seed1.ngd.network
CHAIN_ID=12227332
# Mainnet (chainId 47763):
# NODE_URL=https://mainnet-1.rpc.banelabs.org
# CHAIN_ID=47763

# --- Indexer tuning ---
# Blocks fetched per batch.
BATCH_SIZE=25
# Seconds between tip checks when caught up.
KEEP_ALIVE_INTERVAL=5
# First block to index when the DB is empty (0 = genesis).
START_BLOCK=0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8083
# MySQL pool size for the API.
API_MAX_CONNECTIONS=10
# Seconds between /v1/neox/stats count refreshes.
STATS_REFRESH_INTERVAL=300
# Seconds between /v1/neox/stat/* refreshes. Heavier than the counts above; raise it on a
# large chain.
STATISTICS_REFRESH_INTERVAL=900
